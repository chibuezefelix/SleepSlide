<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark window so a night-mode cold start doesn't flash white before Compose draws -->
    <style name="Theme.SleepSlide" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Night launch splash: dark ground rather than a yellow flash at bedtime; the mark keeps its yellow badge. -->
    <style name="Theme.SleepSlide.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SleepSlide</item>
    </style>
</resources>
